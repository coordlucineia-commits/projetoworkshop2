# Supabase (Dashboard → Project Settings → API)
# URL pública do projeto
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Chave anon (pública no front; proteja com RLS no banco)
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# Apenas scripts locais (npm run seed:professor-ramon, seed:aluno-lu, seed:lute-demo).
# Obrigatório para criar usuários em Auth e inserir dados ignorando RLS.
# Não é a mesma que VITE_SUPABASE_ANON_KEY — use a chave "service_role" do painel.
# SUPABASE_SERVICE_ROLE_KEY=
# Opcional: senha ao criar usuário Ramon (≥6 caracteres se o projeto exige no Dashboard → Email)
# RAMON_PASSWORD=

# Opcional: senha ao criar aluno de teste lu.t@teste.com (npm run seed:aluno-lu). Padrão: lu1234
# LU_ALUNO_PASSWORD=

# Opcional: senha única demo (npm run seed:lute-demo — 10 alunos + recepção + 3 professores). Padrão: LuteDemo26
# LUTE_DEMO_PASSWORD=

# Opcional — script npm run seed:professor-auth (criar login + vincular public.professores.auth_user_id)
# PROFESSOR_AUTH_PASSWORD=

# Opcional: ambiente exibido em logs / futuros feature flags
VITE_APP_ENV=development

# Opcional: URL pública para links absolutos em lembretes (SSR). No browser usa window.origin.
VITE_PUBLIC_SITE_URL=https://sua-aplicacao.com

# Credenciais por e-mail para novo professor/aluno (Edge Function `welcome-user-credentials`)
# Secrets no Supabase Dashboard → Edge Functions: RESEND_API_KEY, opcional RESEND_FROM_EMAIL
# Sem RESEND: usuário Auth ainda é criado; senha aparece no toast para o gestor enviar manualmente.

# Opcional: seed de ficha fictícia — npm run seed:lucineia-avaliacao (usa SUPABASE_SERVICE_ROLE_KEY; flag --replace para sobrescrever)
# LUCINEIA_AGENDA_ID=

